ARG BASE=python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30
FROM ${BASE}
ARG TORCH=2.11.0+cu128
ARG TORCH_INDEX=https://download.pytorch.org/whl/cu128
RUN pip install --no-cache-dir "torch==${TORCH}" --index-url "${TORCH_INDEX}"
COPY deploy/image/requirements-train.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt
WORKDIR /work
COPY src /work/src
COPY workloads /work/workloads
ENV PYTHONPATH=/work/src PYTHONUNBUFFERED=1
